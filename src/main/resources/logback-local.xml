<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging of a server the desktop client runs. stdout carries the client control protocol only,
  so there is no console appender: everything goes to the file LocalLauncher passes as
  logging.file.name (dataDir/logs/local-server.log), rolled by Spring Boot's file appender.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH:-${LOG_TEMP:-${java.io.tmpdir:-/tmp}}}/local-server.log}"/>
    <include resource="org/springframework/boot/logging/logback/file-appender.xml"/>
    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
